{
  "entities": {
    "ContactSubmission": {
      "title": "Contact Submission",
      "description": "Messages submitted from customer inquiries",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer name", "maxLength": 150 },
        "phone": { "type": "string", "description": "Customer phone or email", "maxLength": 100 },
        "message": { "type": "string", "description": "Inquiry message", "maxLength": 5000 },
        "timestamp": { "type": "string", "description": "Server submission timestamp" }
      },
      "required": ["name", "phone", "message"]
    },
    "Order": {
      "title": "Order",
      "description": "Book and stationery orders placed by customers",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Unique order ID", "maxLength": 100 },
        "paymentId": { "type": "string", "description": "Payment transaction ID", "maxLength": 120 },
        "customerName": { "type": "string", "description": "Customer name", "maxLength": 150 },
        "customerPhone": { "type": "string", "description": "Customer phone", "maxLength": 50 },
        "customerAddress": { "type": "string", "description": "Delivery address", "maxLength": 500 },
        "itemName": { "type": "string", "description": "Order summary title", "maxLength": 500 },
        "itemType": { "type": "string", "description": "Books or Stationery category", "maxLength": 100 },
        "amount": { "type": "number", "description": "Order total in INR" },
        "status": { "type": "string", "description": "Order status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["orderId", "customerName", "customerPhone", "itemName", "amount", "status"]
    },
    "CatalogDoc": {
      "title": "Catalog Document",
      "description": "Storefront books and stationery catalog stored in /appData/catalog",
      "type": "object",
      "properties": {
        "items": { "type": "array", "description": "Array of Books and Stationery products with 6x9 cover previews and specs" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" }
      }
    }
  },
  "firestore": {
    "/contactSubmissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Customer inquiries"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer bookstore and stationery orders"
    },
    "/appData/{docId}": {
      "schema": "CatalogDoc",
      "description": "Configurable Books and Stationery catalog data"
    }
  }
}
